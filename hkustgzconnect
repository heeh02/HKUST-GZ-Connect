#!/usr/bin/env bash
# macOS wrapper for the independent Rust EasyConnect engine.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
ENGINE="$HERE/independent/target/release/ec-engine"
ENGINE_CONFIG="$HERE/independent/config/hkustgz.json"
CONF="$HERE/config.toml"

RUNDIR="$HOME/.hkustgzconnect"
LOG="$RUNDIR/hkustgzconnect.log"
PIDFILE="$RUNDIR/hkustgzconnect.pid"
KEYCHAIN_SERVICE="hkustgzconnect"
SOCKS_HOST="127.0.0.1"
SOCKS_PORT="$(awk -F'[:\"]' '/^socks_bind/{print $(NF-1); exit}' "$CONF" 2>/dev/null)"
SOCKS_PORT="${SOCKS_PORT:-1080}"
LABEL="com.hkustgz.connect"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
HPC_PROBE_IP="10.120.48.30"

mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"

ACC="$(awk -F'"' '/^username/{print $2; exit}' "$CONF" 2>/dev/null)"
die(){ echo "✗ $*" >&2; exit 1; }
[ -f "$CONF" ] || die "missing local identity config: $CONF"
[ -n "$ACC" ] || die "no username in $CONF"

get_pw(){ security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$ACC" -w 2>/dev/null; }
running_pid(){ [ -f "$PIDFILE" ] && awk 'NR==1{print; exit}' "$PIDFILE" 2>/dev/null; }
is_up(){ local p; p="$(running_pid)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
socks_listening(){ lsof -nP -iTCP@"$SOCKS_HOST":"$SOCKS_PORT" -sTCP:LISTEN >/dev/null 2>&1; }
svc_loaded(){ launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; }

ensure_engine(){
  [ -x "$ENGINE" ] && return 0
  if command -v cargo >/dev/null 2>&1; then
    cargo_runner=(cargo)
  elif command -v rustup >/dev/null 2>&1; then
    toolchain_bin="$(dirname "$(rustup which rustc --toolchain 1.97.1)")"
    cargo_runner=(env "PATH=$toolchain_bin:$PATH" rustup run 1.97.1 cargo)
  else
    die "engine missing and cargo/rustup is unavailable"
  fi
  (cd "$HERE/independent" && "${cargo_runner[@]}" build --locked --release --bin ec-engine) \
    || die "independent engine build failed"
}

wait_socks(){
  for _ in $(seq 1 20); do
    socks_listening && return 0
    grep -qiE "authentication failed|unsupported|ec-engine:" "$LOG" 2>/dev/null && return 1
    sleep 1
  done
  socks_listening
}

report_up(){
  if socks_listening; then
    echo "✓ up — independent Rust SOCKS5 $SOCKS_HOST:$SOCKS_PORT"
  else
    echo "✗ failed to come up — last log lines:"
    tail -8 "$LOG" 2>/dev/null | sed 's/^/  /'
    return 1
  fi
}

run_engine(){
  local pw
  pw="$(get_pw)" || true
  [ -n "${pw:-}" ] || die "no password in Keychain — run: $(basename "$0") set-password"
  {
    printf '%s\n' "$ACC"
    printf '%s\n' "$pw"
  } | "$ENGINE" \
    --config "$ENGINE_CONFIG" \
    --credentials-stdin \
    --socks-bind "$SOCKS_HOST:$SOCKS_PORT"
}

case "${1:-}" in
  set-password)
    printf "Password for %s @ HKUST-GZ VPN: " "$ACC" >&2
    read -rs pw
    echo >&2
    [ -n "$pw" ] || die "empty password"
    security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$ACC" -w "$pw" \
      && echo "✓ stored in Keychain"
    ;;

  run)
    ensure_engine
    echo $$ > "$PIDFILE"
    run_engine
    ;;

  up)
    socks_listening && { echo "✓ already running — SOCKS5 $SOCKS_HOST:$SOCKS_PORT"; exit 0; }
    ensure_engine
    get_pw >/dev/null 2>&1 || die "no password in Keychain — run set-password"
    : > "$LOG"
    if [ -f "$PLIST" ]; then
      launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
        || launchctl kickstart "gui/$(id -u)/$LABEL" 2>/dev/null
    else
      nohup "$0" run >>"$LOG" 2>&1 &
      echo $! > "$PIDFILE"
      disown 2>/dev/null || true
    fi
    wait_socks
    report_up || { "$0" down >/dev/null 2>&1; exit 1; }
    ;;

  down)
    svc_loaded && launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    local_pid="$(running_pid)"
    [ -n "$local_pid" ] && kill -INT "$local_pid" 2>/dev/null
    pkill -f "$ENGINE --config $ENGINE_CONFIG" 2>/dev/null
    [ -f "$PIDFILE" ] && mv "$PIDFILE" "$RUNDIR/hkustgzconnect.pid.stopped"
    echo "✓ down"
    ;;

  restart)
    "$0" down >/dev/null 2>&1
    sleep 1
    exec "$0" up
    ;;

  status)
    if is_up; then echo "● running (pid $(running_pid))"; else echo "○ not running"; fi
    socks_listening && echo "  SOCKS5 $SOCKS_HOST:$SOCKS_PORT: listening" || echo "  SOCKS5: not listening"
    get_pw >/dev/null 2>&1 && echo "  Keychain password: present" || echo "  Keychain password: missing"
    [ -x "$ENGINE" ] && echo "  independent engine: built" || echo "  independent engine: not built"
    [ -f "$PLIST" ] && echo "  autostart: installed" || echo "  autostart: not installed"
    ;;

  test)
    socks_listening || die "SOCKS not listening"
    echo -n "HPC $HPC_PROBE_IP:22 via independent SOCKS → "
    banner="$(nc -X 5 -x "$SOCKS_HOST:$SOCKS_PORT" -G 6 -w 6 "$HPC_PROBE_IP" 22 </dev/null 2>&1 | head -1)"
    [ -n "$banner" ] && echo "$banner" || echo "(no banner / unreachable)"
    ;;

  install)
    ensure_engine
    get_pw >/dev/null 2>&1 || die "set the password first"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$HERE/hkustgzconnect</string><string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PLIST
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
      || launchctl load "$PLIST" 2>/dev/null
    echo "✓ independent engine autostart installed"
    : > "$LOG"
    wait_socks
    report_up
    ;;

  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null \
      || launchctl unload "$PLIST" 2>/dev/null
    [ -f "$PLIST" ] && mv "$PLIST" "$RUNDIR/com.hkustgz.connect.plist.uninstalled"
    echo "✓ autostart removed"
    ;;

  logs)
    tail -n 40 -f "$LOG"
    ;;

  *)
    cat <<USAGE
hkustgzconnect — independent Rust EasyConnect client

  set-password   store the VPN password in macOS Keychain
  up             build if needed and start SOCKS5
  down           stop the engine
  restart        restart the engine
  status         show engine and SOCKS state
  test           read the approved HPC SSH banner through SOCKS
  logs           follow engine logs
  install        install launchd autostart
  uninstall      remove launchd autostart
USAGE
    ;;
esac
