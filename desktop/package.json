{
  "name": "hkustgzconnect",
  "version": "1.0.6",
  "description": "HKUST(GZ) EasyConnect-compatible client with an independent Rust engine",
  "main": "main.js",
  "author": "heeh02",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node --test",
    "test:renderer-layout": "electron e2e/resource-manager-layout.electron.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5"
  },
  "build": {
    "appId": "cn.edu.hkust-gz.connect",
    "productName": "hkustgzconnect",
    "artifactName": "hkustgzconnect-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "campus-preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": ["ec-engine-*", "ec-engine.exe", "hkustgz.json"]
      }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "hkustgzconnect-${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network"
    }
  }
}
